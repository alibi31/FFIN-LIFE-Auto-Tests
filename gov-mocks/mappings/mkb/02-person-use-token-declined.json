{
  "name": "MKB person-use-token: клиент ответил 512 (отказ). ИИН с порядковым номером 91xx -> 502 INVALID",
  "priority": 3,
  "request": {
    "method": "POST",
    "url": "/api/v1/soap/mkb/person-use-token",
    "headers": { "x-api-key": { "matches": ".+" } },
    "bodyPatterns": [ { "matchesJsonPath": "$.params[?(@.iin =~ /^[0-9]{7}91[0-9]{3}$/)]" } ]
  },
  "response": {
    "status": 502,
    "headers": { "Content-Type": "application/json; charset=utf-8" },
    "jsonBody": { "success": false, "kdp_status": "INVALID", "error": "Субъект отказал в доступе." }
  }
}
