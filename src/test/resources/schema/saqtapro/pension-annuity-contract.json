{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SaqtaPro: договор пенсионного аннуитета (POST v2 / GET v1)",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": { "type": "boolean" },
    "data": {
      "type": "object",
      "required": [
        "id", "contract_number", "product_name", "sales_channel", "jurek_program_id",
        "annuity_payment_type", "conclusion_date", "signing_type",
        "policyholder", "insured", "beneficiaries", "calculation", "registration_payload", "executor"
      ],
      "properties": {
        "id": { "type": "integer" },
        "contract_number": { "type": "string", "minLength": 1 },
        "esbd_contract_number": { "type": ["string", "null"] },
        "product_name": { "type": "string" },
        "sales_channel": { "type": "string" },
        "jurek_program_id": { "type": "integer" },
        "jurek_program_type": { "type": ["string", "null"] },
        "annuity_payment_type": { "$ref": "#/definitions/valueLabel" },
        "conclusion_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "signing_type": { "$ref": "#/definitions/valueLabel" },
        "policyholder": {
          "type": "object",
          "required": ["full_name", "bin", "phone_number"],
          "properties": {
            "full_name": { "type": "string" },
            "bin": { "type": "string", "pattern": "^\\d{12}$" },
            "phone_number": { "type": ["string", "null"] }
          }
        },
        "insured": {
          "type": "object",
          "required": ["uin", "full_name"],
          "properties": {
            "uin": { "type": "string", "pattern": "^\\d{12}$" },
            "full_name": { "type": "string" },
            "phone_number": { "type": ["string", "null"] }
          }
        },
        "beneficiaries": { "type": "array" },
        "third_parties": { "type": "array" },
        "trusted_person": { "type": ["object", "null"] },
        "calculation": {
          "type": "object",
          "required": ["calculation_id", "insured", "calculation", "mandatory_pension_contributions"],
          "properties": {
            "calculation_id": { "type": "integer" },
            "calculation_date": { "type": "string" },
            "contract_start_date": { "type": "string" },
            "mandatory_pension_contributions": { "type": "number" },
            "voluntary_pension_contributions": { "type": "number" },
            "payment_schedule_pdf_url": { "type": ["string", "null"] },
            "payment_schedule_pdf_url_kz": { "type": ["string", "null"] },
            "insured": {
              "type": "object",
              "required": ["uin", "gender", "birth_date"],
              "properties": {
                "uin": { "type": "string" },
                "gender": { "enum": ["MALE", "FEMALE"] },
                "birth_date": { "type": "string" }
              }
            },
            "calculation": {
              "type": "object",
              "required": ["status", "data"],
              "properties": {
                "status": { "type": "boolean" },
                "data": {
                  "type": "object",
                  "required": ["insurance_premium", "annuity_payment", "premium_is_enough", "payments_schedule"],
                  "properties": {
                    "insurance_premium": { "type": "number" },
                    "annuity_payment": { "type": "number" },
                    "premium_is_enough": { "type": "boolean" },
                    "payments_schedule": {
                      "type": "object",
                      "required": ["start_date", "schedule"],
                      "properties": {
                        "schedule": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": ["year", "months"],
                            "properties": {
                              "year": { "type": "integer" },
                              "months": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "required": ["date", "amount"],
                                  "properties": {
                                    "date": { "type": "string" },
                                    "amount": { "type": "number" }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "registration_payload": {
          "type": "object",
          "required": ["insured_uin", "insured_iban", "bank_bic", "calculation_id", "signing_type"],
          "properties": {
            "insured_uin": { "type": "string" },
            "insured_iban": { "type": "string", "pattern": "^KZ\\d{2}[0-9A-Z]{16}$" },
            "bank_bic": { "type": "string" },
            "calculation_id": { "type": "integer" },
            "signing_type": { "type": "string" }
          }
        },
        "executor": {
          "type": "object",
          "required": ["id", "iin", "name"]
        }
      }
    }
  },
  "definitions": {
    "valueLabel": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" }
      }
    }
  }
}
