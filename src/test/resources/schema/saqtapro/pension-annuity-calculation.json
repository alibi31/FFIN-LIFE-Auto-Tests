{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SaqtaPro: расчёт пенсионного аннуитета (POST /api/v1/contracts/pension-annuity/calculations)",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": { "type": "boolean" },
    "data": {
      "type": "object",
      "required": [
        "calculation_id", "calculation_date", "contract_start_date", "insured", "disability",
        "guaranteed_period_years", "dividend_percent",
        "mandatory_pension_contributions", "voluntary_pension_contributions", "own_expenses",
        "own_funds_from_dividends", "other_life_insurance_company_redemption",
        "mandatory_professional_pension_contributions", "calculation",
        "payment_schedule_pdf_url", "payment_schedule_pdf_url_kz"
      ],
      "properties": {
        "calculation_id": { "type": "integer", "minimum": 1 },
        "calculation_date": { "$ref": "#/definitions/date" },
        "contract_start_date": { "$ref": "#/definitions/date" },
        "buffer": {},
        "insured": {
          "type": "object",
          "required": ["uin", "gender", "birth_date", "phone_number"],
          "properties": {
            "uin": { "type": "string", "pattern": "^\\d{12}$" },
            "gender": { "enum": ["MALE", "FEMALE"] },
            "birth_date": { "$ref": "#/definitions/date" },
            "phone_number": { "type": ["string", "null"] }
          }
        },
        "disability": { "type": "string" },
        "guaranteed_period_years": { "type": "integer", "minimum": 0, "maximum": 30 },
        "dividend_percent": { "type": "number" },
        "is_immediate_annuity_superapp": { "type": "boolean" },
        "mandatory_pension_contributions": { "$ref": "#/definitions/amount" },
        "voluntary_pension_contributions": { "$ref": "#/definitions/amount" },
        "own_expenses": { "$ref": "#/definitions/amount" },
        "own_funds_from_dividends": { "$ref": "#/definitions/amount" },
        "other_life_insurance_company_redemption": { "$ref": "#/definitions/amount" },
        "other_life_insurance_company_mppc_monthes": { "type": "integer", "minimum": 0 },
        "mandatory_professional_pension_contributions": {
          "type": "object",
          "required": ["amount", "months"],
          "properties": {
            "amount": { "$ref": "#/definitions/amount" },
            "months": { "type": "integer", "minimum": 0 }
          }
        },
        "payment_schedule_pdf_url": { "type": ["string", "null"] },
        "payment_schedule_pdf_url_kz": { "type": ["string", "null"] },
        "calculation": {
          "type": "object",
          "required": ["status", "message", "data"],
          "properties": {
            "status": { "type": "boolean" },
            "message": { "type": "string" },
            "data": {
              "type": "object",
              "required": [
                "minimum_premium_sum", "missing_premium_sum", "is_immediate_annuity", "insurance_premium",
                "annuity_payment", "insurance_dividends", "insurance_dividends_NEW", "premium_is_enough",
                "payments_schedule"
              ],
              "properties": {
                "minimum_premium_sum": { "$ref": "#/definitions/amount" },
                "missing_premium_sum": { "$ref": "#/definitions/amount" },
                "is_immediate_annuity": { "type": "boolean" },
                "insurance_premium": { "$ref": "#/definitions/amount" },
                "annuity_payment": { "$ref": "#/definitions/amount" },
                "insurance_dividends": { "$ref": "#/definitions/amount" },
                "insurance_dividends_NEW": { "$ref": "#/definitions/dividends" },
                "premium_is_enough": { "type": "boolean" },
                "dividend_limit_message": { "type": ["string", "null"] },
                "payments_schedule": {
                  "type": "object",
                  "required": ["start_date", "start_age", "is_immediate_annuity", "dividends", "schedule"],
                  "properties": {
                    "start_date": { "$ref": "#/definitions/date" },
                    "start_age": { "type": "integer" },
                    "is_immediate_annuity": { "type": "boolean" },
                    "dividends": { "$ref": "#/definitions/dividends" },
                    "schedule": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["year", "months"],
                        "properties": {
                          "year": { "type": "integer" },
                          "months": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 12,
                            "items": {
                              "type": "object",
                              "required": ["date", "amount"],
                              "properties": {
                                "date": { "$ref": "#/definitions/date" },
                                "amount": { "$ref": "#/definitions/amount" }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "amount": { "type": "integer", "minimum": 0 },
    "dividends": {
      "type": "object",
      "required": ["kzt", "start_date"],
      "properties": {
        "kzt": { "$ref": "#/definitions/amount" },
        "etn": {},
        "start_date": { "$ref": "#/definitions/date" }
      }
    }
  }
}
